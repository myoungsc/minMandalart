# 기본은 ~/.appstore/ 의 공통 키를 쓴다. 다른 키를 쓸 때만 fastlane/.env로 복사해 채운다.
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=/absolute/path/to/AuthKey.p8
# PLAY_JSON_KEY_PATH=/absolute/path/to/play-service-account.json
# AdMob 광고 단위 ID. ios beta, android build/internal 에 필요하다.
# ADMOB_HOME_BANNER_ID_IOS=
# ADMOB_BOARD_BANNER_ID_IOS=
# ADMOB_CREATE_INTERSTITIAL_ID_IOS=
# ADMOB_HOME_BANNER_ID_ANDROID=
# ADMOB_BOARD_BANNER_ID_ANDROID=
# ADMOB_CREATE_INTERSTITIAL_ID_ANDROID=
