# 사용법 (프로젝트 루트에서)
#   fastlane ios beta              빌드 → TestFlight 업로드 (심사 제출은 직접)
#   fastlane android build         AAB만 빌드 (Play Console 첫 업로드용)
#   fastlane android internal      빌드 → Play 내부 테스트 트랙 업로드
#   fastlane android internal validate_only:true   업로드 없이 Play 검증만
#   fastlane ios metadata          소개 문구, 심사 메모, 연령 등급(app_rating_config.json)을 App Store Connect에 반영 (심사 제출 안 함)
#   fastlane android metadata      소개 문구만 Play에 반영
#   fastlane android changelogs    출시 노트만 Play에 반영 (기본 production 트랙, track:internal 처럼 바꿀 수 있음)
#   fastlane ios screenshots       fastlane/screenshots/<locale>/ 를 App Store Connect에 반영 (덮어씀)
#   fastlane android screenshots   metadata/android/<locale>/images/phoneScreenshots/ 를 Play에 반영
#   fastlane android images        metadata/android/<locale>/images/ 의 icon.png, featureGraphic.png 를 Play에 반영
#
# 스크린샷 폴더: fastlane/screenshots/<locale>/ 에 파일 이름 순서대로. 크기로 기기를 구분한다.
#   iPhone 6.7형 1290×2796, iPhone Duo 2007×2853 (fastlane 2.241.1 이상 필요), iPad 13형 2064×2752
#   locale 은 metadata/ios 와 같게: en-US, ko, ja, es-ES, fr-FR, ru. 없는 언어는 기본 언어(ko) 것을 따른다.
#
# 버전은 pubspec.yaml 에서 관리한다. (lane 은 버전을 바꾸지 않는다)
# 인증 정보는 ~/.appstore/ 의 공통 키를 쓴다.
#   ~/.appstore/env                       ASC_KEY_ID, ASC_ISSUER_ID
#   ~/.appstore/AuthKey_<ASC_KEY_ID>.p8   App Store Connect API 키
#   ~/.appstore/play-service-account.json Play 서비스 계정 키
# 다른 키를 쓰려면 fastlane/.env 에 값을 적는다. (.env.example 참고, 먼저 적용된다)
# 광고 단위 ID는 fastlane/.env 의 ADMOB_{HOME_BANNER,BOARD_BANNER,CREATE_INTERSTITIAL}_ID_{IOS,ANDROID} 에 둔다.
# 없으면 빌드 전에 멈춘다(테스트 광고가 출시 빌드에 들어가지 않게).
# AdMob 앱 ID: iOS는 ios/Flutter/AdMob.xcconfig, Android는 ~/.appstore/miniManda-admob.properties

require "dotenv"
Dotenv.load(File.expand_path("~/.appstore/env")) # 이미 있는 값은 덮어쓰지 않는다
ENV["ASC_KEY_PATH"] ||= "~/.appstore/AuthKey_#{ENV['ASC_KEY_ID']}.p8" if ENV["ASC_KEY_ID"]
ENV["PLAY_JSON_KEY_PATH"] ||= "~/.appstore/play-service-account.json"

ROOT = File.expand_path("..", __dir__)

# 값이 비었거나 파일이 없으면 빌드 전에 멈춘다.
def require_env!(keys, file_keys)
  missing = keys.select { |k| ENV[k].to_s.strip.empty? }
  missing += file_keys.reject { |k| ENV[k].to_s.strip.empty? || File.exist?(File.expand_path(ENV[k])) }
                      .map { |k| "#{k} (파일 없음: #{ENV[k]})" }
  UI.user_error!("인증 정보 확인 필요(~/.appstore 또는 fastlane/.env): #{missing.join(', ')}") unless missing.empty?
end

ADMOB_UNITS = %w[HOME_BANNER BOARD_BANNER CREATE_INTERSTITIAL].freeze

# 광고 단위 ID를 확인하고 --dart-define 인자로 만든다. platform: "IOS" 또는 "ANDROID"
def admob_defines(platform)
  keys = ADMOB_UNITS.map { |u| "ADMOB_#{u}_ID_#{platform}" }
  require_env!(keys, [])
  ADMOB_UNITS.map { |u| "--dart-define=ADMOB_#{u}_ID=#{ENV["ADMOB_#{u}_ID_#{platform}"]}" }.join(" ")
end

def android_build_cmd
  admob = File.expand_path("~/.appstore/miniManda-admob.properties")
  UI.user_error!("AdMob 앱 ID 파일 없음: #{admob}") unless File.exist?(admob)
  "cd #{ROOT} && flutter build appbundle --release #{admob_defines('ANDROID')}"
end

platform :ios do
  desc "빌드 → TestFlight 업로드"
  lane :beta do
    require_env!(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH], %w[ASC_KEY_PATH])
    defines = admob_defines("IOS")
    UI.user_error!("AdMob 앱 ID 파일 없음: ios/Flutter/AdMob.xcconfig") unless File.exist?(File.join(ROOT, "ios/Flutter/AdMob.xcconfig"))
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"])
    )

    # 서명은 Xcode 에 로그인된 계정으로 한다.
    FileUtils.rm_rf(File.join(ROOT, "build/ios/ipa"))
    sh("cd #{ROOT} && flutter build ipa --release #{defines}")

    upload_to_testflight(
      api_key: api_key,
      ipa: Dir[File.join(ROOT, "build/ios/ipa/*.ipa")].first,
      skip_waiting_for_build_processing: true
    )
  end

  desc "소개 문구만 App Store Connect에 반영 (심사 제출 안 함)"
  lane :metadata do
    require_env!(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH], %w[ASC_KEY_PATH])
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"])
    )
    upload_to_app_store(
      api_key: api_key,
      metadata_path: File.join(ROOT, "fastlane/metadata/ios"),
      # 연령 등급 중 바뀐 항목만 적어 둔다(광고 있음).
      app_rating_config_path: File.join(ROOT, "fastlane/app_rating_config.json"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "스크린샷만 App Store Connect에 반영 (기존 것을 덮어씀, 심사 제출 안 함)"
  lane :screenshots do
    require_env!(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH], %w[ASC_KEY_PATH])
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"])
    )
    upload_to_app_store(
      api_key: api_key,
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      # skip_metadata 여도 metadata_path 폴더 이름을 검사하므로 ios 폴더를 지정한다.
      metadata_path: File.join(ROOT, "fastlane/metadata/ios"),
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end

platform :android do
  desc "AAB만 빌드 (Play Console 첫 업로드용)"
  lane :build do
    sh(android_build_cmd)
  end

  desc "빌드 → Play 내부 테스트 트랙 업로드"
  lane :internal do |options|
    require_env!(%w[PLAY_JSON_KEY_PATH], %w[PLAY_JSON_KEY_PATH])

    sh(android_build_cmd)

    upload_to_play_store(
      track: "internal",
      aab: File.join(ROOT, "build/app/outputs/bundle/release/app-release.aab"),
      json_key: File.expand_path(ENV["PLAY_JSON_KEY_PATH"]),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only] || false
    )
  end

  desc "소개 문구만 Play에 반영"
  lane :metadata do
    require_env!(%w[PLAY_JSON_KEY_PATH], %w[PLAY_JSON_KEY_PATH])
    upload_to_play_store(
      json_key: File.expand_path(ENV["PLAY_JSON_KEY_PATH"]),
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      # 변경 내역은 빌드(version code)에 붙으므로 빌드 업로드 없이 올리면 실패한다.
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "출시 노트(changelogs/default.txt)만 Play에 반영. pubspec 버전 코드의 출시가 트랙에 먼저 있어야 한다"
  lane :changelogs do |options|
    require_env!(%w[PLAY_JSON_KEY_PATH], %w[PLAY_JSON_KEY_PATH])
    version_code = File.read(File.join(ROOT, "pubspec.yaml"))[/^version:\s*\S+\+(\d+)/, 1]
    UI.user_error!("pubspec.yaml 에서 버전 코드를 찾지 못함") unless version_code
    upload_to_play_store(
      json_key: File.expand_path(ENV["PLAY_JSON_KEY_PATH"]),
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      track: options[:track] || "production",
      version_code: version_code.to_i,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "스크린샷만 Play에 반영 (아이콘·그래픽 이미지는 올리지 않음)"
  lane :screenshots do
    require_env!(%w[PLAY_JSON_KEY_PATH], %w[PLAY_JSON_KEY_PATH])
    upload_to_play_store(
      json_key: File.expand_path(ENV["PLAY_JSON_KEY_PATH"]),
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false
    )
  end

  desc "앱 아이콘(512×512)·그래픽 이미지(1024×500)만 Play에 반영"
  lane :images do
    require_env!(%w[PLAY_JSON_KEY_PATH], %w[PLAY_JSON_KEY_PATH])
    upload_to_play_store(
      json_key: File.expand_path(ENV["PLAY_JSON_KEY_PATH"]),
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: true
    )
  end
end
